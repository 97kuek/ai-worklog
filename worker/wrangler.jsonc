{
  "name": "ai-worklog",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-worklog",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
