# Copy this file to .dev.vars and fill in the values for local development.
# .dev.vars is ignored by Git. Never commit real values.

# Cloudflare Zero Trust team domain, e.g. your-team.cloudflareaccess.com
ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag of the Cloudflare Access application
ACCESS_AUD=
# Email address of the owner; the only user the Worker accepts
OWNER_EMAIL=
